<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copies the Notion bill tracker to each sender's runs/<sender>/data/bills.md at half past every hour
     and once at load. Runs missed while the Mac slept collapse into one on wake. Renewal texts go out
     only between 7 AM and 9 PM (noticeHours in jobs/bills_export.ts).
     Install: replace REPO with the absolute path of this repository, copy to ~/Library/LaunchAgents,
     then launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/jarvis.bills-export.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.jarvis.bills-export</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>jobs/bills_export.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPO/listener</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>REPO/state/jarvis.bills-export.log</string>
  <key>StandardErrorPath</key>
  <string>REPO/state/jarvis.bills-export.err.log</string>
</dict>
</plist>
